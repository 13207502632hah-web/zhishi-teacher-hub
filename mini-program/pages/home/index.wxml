<view class="page">
  <view class="hero"><view class="eyebrow">知师研室 · 学习端</view><view class="title">{{me.role==='parent'?'孩子的作业与订正':'我的作业与订正'}}</view><view class="muted">只展示教师已经确认并发布的学习内容</view></view>
  <view wx:if="{{error}}" class="card error"><text>{{error}}</text><view wx:if="{{diagnostic}}" class="diagnostic">诊断信息：{{diagnostic}}</view><view wx:if="{{showTestLogin}}" class="buttonRow"><button wx:for="{{testRoles}}" wx:key="*this" size="mini" class="secondary" data-role="{{item}}" bindtap="login">测试{{item==='parent'?'家长':'学生'}}</button></view><button wx:else class="primary" loading="{{loginRetrying}}" disabled="{{loginRetrying}}" bindtap="realLogin">{{loginRetrying?'正在重新登录…':'重新微信登录'}}</button></view>
  <view wx:if="{{me && me.bindingRequired}}" class="card notice"><view class="muted">微信账号编号：#{{me.accountId}}。输入教师网站生成的邀请码后提交绑定申请。</view></view>
  <view wx:if="{{me && me.bindingRequired}}" class="card warning"><view class="title small">尚未完成绑定</view><view class="muted">输入邀请码后还需教师在网站确认，确认前不会显示学生数据。</view><button class="primary" bindtap="bindAccount">输入邀请码</button></view>
  <view wx:if="{{me && me.bindingStatus==='pending'}}" class="card warning"><view class="title small">绑定申请待教师确认</view><view class="muted">确认后下拉刷新即可读取对应学生数据。</view></view>
  <view wx:if="{{loading}}" class="skeleton">正在同步作业…</view>
  <view wx:if="{{!loading&&!error&&me&&!me.bindingRequired}}" class="card"><view class="title small">跟读与听写</view><view class="muted">播放教师示范、录制语音并提交；中途退出会保留草稿。</view><button class="secondary" bindtap="openDictations">打开训练任务</button></view>
  <view wx:if="{{!loading&&!items.length&&!error}}" class="empty">暂时没有可见作业<br/><text>下拉可重新同步</text></view>
  <view wx:for="{{items}}" wx:key="id" class="card assignmentCard" data-id="{{item.id}}" bindtap="open"><view><text class="tag">{{item.status==='published'?'进行中':'已关闭'}}</text><text wx:if="{{item.revisionCount}}" class="tag alert">需订正 {{item.revisionCount}}</text></view><view class="title small">{{item.title}}</view><view class="bodyText">{{item.requirements||'请按教师要求完成'}}</view><view class="muted">截止：{{item.dueAt||'未设置'}} · 附件 {{item.assetCount||0}}</view></view>
</view>
