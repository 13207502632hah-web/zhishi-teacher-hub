<view class="page"><view class="hero"><view class="eyebrow">知师研室 · 私有资料</view><view class="title">班级资料</view><view class="muted">只显示教师已确认发布、当前学生所在班级的文件</view></view><picker wx:if="{{me&&me.students.length>1}}" mode="selector" range="{{me.students}}" range-key="studentName" value="{{studentIndex}}" bindchange="switchStudent"><view class="card">切换孩子：{{me.students[studentIndex].studentName}}</view></picker><view wx:if="{{loading}}" class="skeleton">正在同步班级资料…</view><view wx:if="{{error}}" class="card error">{{error}}<button class="secondary" bindtap="load">重试</button></view><view wx:if="{{!loading&&!error&&!files.length}}" class="empty">暂时没有班级资料<br/><text>教师发布后会显示在这里</text></view><view wx:for="{{files}}" wx:key="id" class="card"><text class="tag">{{item.category}}</text><view class="title small">{{item.title}}</view><view class="bodyText">{{item.description||'教师未填写资料说明'}}</view><view class="muted">{{item.className}} · {{item.fileName}}</view><button class="secondary fileButton" data-index="{{index}}" bindtap="open">{{playingId===item.id?'正在播放':'下载并打开'}}</button></view></view>
