<view class="page"><view class="hero"><view class="eyebrow">家校消息</view><view class="title">{{me.role==='parent'?'孩子的通知与回执':'我的通知与回执'}}</view><view class="muted">只显示教师确认发布、属于当前身份的内容</view></view><picker wx:if="{{me && me.students.length>1}}" mode="selector" range="{{me.students}}" range-key="studentName" value="{{studentIndex}}" bindchange="switchStudent"><view class="card">切换孩子：{{me.students[studentIndex].studentName}}</view></picker><view wx:if="{{loading}}" class="skeleton">正在加载消息…</view><view wx:if="{{error}}" class="card error">{{error}}</view><view wx:if="{{!loading && notices.length}}" class="statRow"><view><b>{{counts.unread||0}}</b><text>未读</text></view><view><b>{{counts.unacknowledged||0}}</b><text>待知晓</text></view></view><view wx:for="{{notices}}" wx:key="id" class="card"><view><text class="tag">{{item.audienceRole==='parent'?'家长通知':item.audienceRole==='student'?'学生通知':'共同通知'}}</text><text wx:if="{{!item.readAt}}" class="tag alert">未读</text><text wx:elif="{{item.acknowledgedAt}}" class="tag">已知晓</text></view><view class="title small">{{item.title}}</view><view class="muted">{{item.className}} · {{item.publishedAt}}</view><view wx:if="{{expandedId===item.id}}" class="bodyText">{{item.content}}</view><button class="secondary" data-id="{{item.id}}" bindtap="openNotice">{{expandedId===item.id?'收起正文':'打开并阅读'}}</button><button wx:if="{{expandedId===item.id && !item.acknowledgedAt}}" class="primary" loading="{{busyId===item.id}}" disabled="{{busyId===item.id}}" data-id="{{item.id}}" bindtap="acknowledge">我已知晓</button></view><view wx:if="{{!loading&&!notices.length&&!error}}" class="empty">暂时没有家校消息<br/><text>教师确认发布后会出现在这里</text></view></view>
