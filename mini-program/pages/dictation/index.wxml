<view class="page"><view class="hero"><view class="eyebrow">知师研室 · 训练任务</view><view class="title">跟读与听写</view><view class="muted">只展示教师已确认发布、属于当前学生的任务</view></view><picker wx:if="{{me&&me.students.length>1}}" mode="selector" range="{{me.students}}" range-key="studentName" value="{{studentIndex}}" bindchange="switchStudent"><view class="card">切换孩子：{{me.students[studentIndex].studentName}}</view></picker><view wx:if="{{loading}}" class="skeleton">正在同步训练任务…</view><view wx:if="{{error}}" class="card error">{{error}}<button class="secondary" bindtap="load">重试</button></view><block wx:if="{{!loading&&!error&&!selected}}"><view wx:if="{{!items.length}}" class="empty">暂时没有训练任务<br/><text>下拉可重新同步</text></view><view wx:for="{{items}}" wx:key="id" class="card assignmentCard" data-id="{{item.id}}" bindtap="open"><text class="tag">{{item.kind==='follow_reading'?'跟读':'听写'}}</text><text wx:if="{{item.revisionCount}}" class="tag alert">需订正 {{item.revisionCount}}</text><view class="title small">{{item.title}}</view><view class="bodyText">{{item.requirements||'请按教师要求完成'}}</view><view class="muted">{{item.itemCount}} 条内容 · 截止 {{item.dueAt||'未设置'}}</view></view></block><view wx:if="{{selected}}"><button class="secondary" bindtap="back">← 返回任务列表</button><view class="card"><text class="tag">{{selected.kind==='follow_reading'?'跟读':'听写'}}</text><view class="title small">{{selected.title}}</view><view class="bodyText">{{selected.requirements||'请按教师要求完成'}}</view><view class="muted">共 {{selected.itemCount}} 条 · 截止 {{selected.dueAt||'未设置'}}</view></view><view wx:if="{{selected.kind==='follow_reading'&&selected.contentItems.length}}" class="card"><view class="title small">跟读原文</view><view wx:for="{{selected.contentItems}}" wx:key="index" class="listRow"><b>{{index+1}}. {{item}}</b></view></view><view wx:if="{{selected.attachments.length}}" class="card"><view class="title small">示范与材料</view><button wx:for="{{selected.attachments}}" wx:key="id" class="secondary fileButton" data-index="{{index}}" bindtap="openFile">{{playingId===item.id?'正在播放':'打开'}}：{{item.name}}</button></view><view wx:if="{{selected.kind==='dictation'}}" class="card notice">听写答案不会在提交前显示；请先播放教师示范，再独立完成。</view><button class="primary fixedAction" bindtap="submit">录音并提交</button></view></view>
