TEACHER_ADMIN_ACCOUNT=
TEACHER_ADMIN_PASSWORD=
TEACHER_ADMIN_SESSION_SECRET=
# 只供 `npm run release:domain` 读取；也可直接把根域名作为命令参数传入。
ZHISHI_ROOT_DOMAIN=
# 仅本地微信开发者工具预览可设为 true，生产必须关闭。
# 生产环境另有代码层门禁：NODE_ENV/CF_PAGES_ENV 为 production 时 mini API 整体返回 503。
WECHAT_TEST_MODE=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 独立内测/生产完成微信验收后才设为 true；未开启时生产环境继续关闭小程序接口。
MINI_FEATURE_ENABLED=false
# OCR 供应商和密钥在莫老师确认费用、隐私条款后再配置。
RECOGNITION_PROVIDER=manual
RECOGNITION_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_AI_ENABLED=false
DEEPSEEK_API_BASE=https://api.deepseek.com

# V2 多模型路由。真实密钥只保存到被 Git 忽略的 .env.local 或托管 Secret。
AI_V2_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_FAST_MODEL=deepseek-v4-flash
OPENAI_REASONING_MODEL=gpt-5.6-luna
OPENAI_VISION_MODEL=mimo-v2-omni
OPENAI_EMBEDDING_MODEL=
# 可选独立向量检索服务；未配置时使用有界本地语义重排并诚实返回 coverage。
VECTOR_SEARCH_URL=
VECTOR_SEARCH_API_KEY=
